{
  "name": "sma-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curricula.mts",
    "build": "next build",
    "postbuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/csp.mts",
    "lint": "eslint && tsc -p src/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:seed-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts",
    "db:migrate": "wrangler d1 migrations apply skillmountainacademy-db --remote",
    "docs:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api-docs.mts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "miniflare": "^5.20261023.3-beta",
    "pdfjs-dist": "^6.5.438",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
