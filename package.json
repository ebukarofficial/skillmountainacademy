{
  "name": "sma-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalogue-export.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curricula.mts",
    "build": "next build",
    "postbuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/csp.mts",
    "lint": "eslint && tsc -p src/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "preview": "wrangler dev",
    "deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy/gate.mts && wrangler deploy",
    "db:seed-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts",
    "db:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/schema.mts",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/backup.mts",
    "db:restore:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/restore.mts",
    "db:state": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/state.mts",
    "db:preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/preflight.mts",
    "db:rehearse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/rehearse.mts",
    "db:compare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/compare.mts",
    "db:decrypt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/decrypt.mts",
    "db:rollback-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/rollback.mts",
    "db:post-restore-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/post-restore.mts",
    "cf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cf.mts",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/preflight.mts --files-only",
    "db:anonymise": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/anonymise.mts",
    "staging:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy/staging-check.mts",
    "security:csp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/security/csp-check.mts",
    "security:secrets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/security/secret-scan.mts",
    "deploy:gate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy/gate.mts",
    "deploy:pin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy/pin.mts",
    "deploy:record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deploy/record.mts",
    "backup:ship": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup/ship.mts",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/migrate-remote.mts",
    "docs:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api-docs.mts",
    "sheet:fees": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sheet-fees.mts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "miniflare": "^5.20261023.3-beta",
    "pdfjs-dist": "^6.5.438",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
