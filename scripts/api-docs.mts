// Writes docs/lms/API.md from the route() calls in src/server/lms/routes/*.ts, so the list is always complete.
//   node scripts/api-docs.mts
import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

export type RouteDef = { method: string; path: string; roles: string; file: string };
export function scanRoutes(root: string): RouteDef[] {
  const dir = join(root, "src/server/lms/routes");
  const out: RouteDef[] = [];
  for (const f of readdirSync(dir).filter((n) => n.endsWith(".ts")).sort()) {
    const src = readFileSync(join(dir, f), "utf8");
    for (const m of src.matchAll(/\b(route|publicRoute)\("(GET|POST|PATCH|PUT|DELETE)", "([^"]+)"(?:, (ALL|\[[^\]]*\]))?/g)) {
      const roles = m[1] === "publicRoute" ? "public" : m[4] === "ALL" ? "student, instructor, admin" : (m[4] ?? "").replace(/[[\]"]/g, "");
      out.push({ method: m[2], path: m[3], roles, file: f });
    }
  }
  return out;
}

export function apiDoc(routes: RouteDef[]): string {
  const rows = routes.map((r) => `| ${r.method} | \`${r.path}\` | ${r.roles} | ${r.file} |`).join("\n");
  return `# Learning platform API (generated)

GENERATED by \`node scripts/api-docs.mts\` from src/server/lms/routes. Do not edit by hand.

- Every \`/api/app/*\` route needs a signed-in session cookie and the role shown; the server checks it on every request.
- Every change (POST, PATCH, PUT, DELETE) must come from the site itself (Origin check).
- JSON in, JSON out: \`{ ok: true, ... }\` or \`{ ok: false, error, message }\` with a matching HTTP status
  (400 invalid, 401 signed out, 403 wrong role or not yours, 404 not found, 409 conflict, 413 too large, 429 slow down, 503 not set up).
- Uploads: \`PUT\` with the raw file as the body and \`?name=<file name>\`.

| Method | Path | Roles | File |
|---|---|---|---|
${rows}
`;
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  const root = join(fileURLToPath(new URL(".", import.meta.url)), "..");
  writeFileSync(join(root, "docs/lms/API.md"), apiDoc(scanRoutes(root)));
  console.log("Wrote docs/lms/API.md");
}
